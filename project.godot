; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Voxel Realms"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://assets/branding/icon.png"
config/windows_native_icon="res://assets/branding/icon.ico"

[audio]

driver/output_latency=60

[autoload]

Net="*res://scripts/net/net.gd"
Account="*res://scripts/net/account.gd"
WorldServer="*res://scripts/server/world_server.gd"
GameServer="*res://scripts/server/game_server.gd"
AppSettings="*res://scripts/settings/app_settings.gd"
GameAudio="*res://scripts/audio/game_audio.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/voxel_export/plugin.cfg")

[rendering]

anti_aliasing/quality/msaa_3d=2
limits/global_shader_variables/buffer_size=1048576

[voxel]

threads/count/margin_below_max=2
threads/main/time_budget_ms=2
